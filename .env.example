# Copy to .env.local (never commit .env.local).
# These are read ONLY on the server (lib/youtube.js is "server-only").
# Do not prefix them with NEXT_PUBLIC_ — that would expose the key to the browser.

YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Optional: used to resolve the channel ID from the @handle if
# YOUTUBE_CHANNEL_ID is not set.
YOUTUBE_CHANNEL_HANDLE=officiallilbardi
