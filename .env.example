# Copy to .env.local (never commit .env.local).
# These are read ONLY on the server (lib/youtube.js and lib/spotify.js are "server-only").
# Do not prefix them with NEXT_PUBLIC_ — that would expose keys to the browser.

# --- YouTube Data API v3 (for the video archive) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Optional: used to resolve the channel ID from the @handle if
# YOUTUBE_CHANNEL_ID is not set.
YOUTUBE_CHANNEL_HANDLE=officiallilbardi

# --- Spotify Web API (for automatic release catalog sync) ---
# Create a free Spotify app at https://developer.spotify.com/dashboard
# Use the Client Credentials flow (app-level, no user login required).
# SPOTIFY_ARTIST_ID is the ID from your artist URL:
#   https://open.spotify.com/artist/<ARTIST_ID>
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_ARTIST_ID=0ece3eqURp6ZSahMp2J7pq
