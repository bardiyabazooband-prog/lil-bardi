# Copy to .env.local (never commit .env.local).
# These are read ONLY on the server (lib/youtube.js and lib/itunes.js are "server-only").
# Do not prefix them with NEXT_PUBLIC_ — that would expose keys to the browser.

# --- YouTube Data API v3 (for the video archive) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Optional: used to resolve the channel ID from the @handle if
# YOUTUBE_CHANNEL_ID is not set.
YOUTUBE_CHANNEL_HANDLE=officiallilbardi

# --- iTunes Search API (for automatic release catalog sync) ---
# The iTunes Search API is free and requires NO authentication.
# Find your artist ID by searching iTunes:
#   https://itunes.apple.com/search?term=YOUR+ARTIST+NAME&entity=song&limit=1
# The "artistId" field in the response is what you need.
# You can also find it in any Apple Music artist URL:
#   https://music.apple.com/artist/lil-bardi/1857068454
ITUNES_ARTIST_ID=1857068454
